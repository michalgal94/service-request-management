{
  "name": "service-request-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hebrew service ticket management — full stack home assignment",
  "engines": { "node": ">=22.13.0", "npm": ">=10" },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/seed-cli.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
